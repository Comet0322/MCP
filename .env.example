# --- server ---
HOST=0.0.0.0
PORT=8000
MCP_PORT=8000
ENV=dev
LOG_LEVEL=INFO

# --- SSO / OIDC (multi-tenant resource server; leave AUTH_ENABLED=false for local dev) ---
# ENV=prod forces AUTH_ENABLED=true and fails fast if any of these are unset.
# No universal defaults -- fill these in with your organization's actual
# OIDC provider values. TENANT_CLAIM_NAME is IdP-specific (e.g. Azure AD
# uses "tid"); check what your provider puts in its JWTs.
AUTH_ENABLED=false
OIDC_ISSUER=
JWKS_URL=
AUDIENCE=
TENANT_CLAIM_NAME=

# --- CORS (only needed if a browser-based client will call this server) ---
ALLOWED_ORIGINS=

# --- agent e2e eval (tests/agent/, only needed to run the slow-marker tests) ---
# Fixed to Anthropic on purpose -- this layer tests whether a Claude
# Code-like agent picks the right tool.
ANTHROPIC_API_KEY=

# --- LLM judge (tests/golden/ assert_type: llm_judge, only needed to run llm_judge cases) ---
# Bring your own OpenAI-compatible provider. No universal default. Examples:
#   OpenAI:      LLM_JUDGE_BASE_URL=https://api.openai.com/v1
#   NVIDIA NIM:  LLM_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
#                LLM_JUDGE_MODEL=meta/llama-3.1-8b-instruct
#                (verified working; smaller hosted models on NVIDIA NIM were
#                unreliable or unresponsive when we tried them -- check
#                build.nvidia.com before picking a different one)
#   Local vLLM:  LLM_JUDGE_BASE_URL=http://localhost:8001/v1
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_MODEL=
