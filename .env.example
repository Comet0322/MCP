# --- server ---
HOST=0.0.0.0
PORT=8000
MCP_PORT=8000
ENV=dev
LOG_LEVEL=INFO

# --- CORS (only needed if a browser-based client will call this server) ---
ALLOWED_ORIGINS=

# --- LLM judge (tests/golden/ assert_type: llm_judge) and agent e2e eval
# (tests/agent/, tool-selection check) -- only needed to run slow-marker
# tests. Bring your own OpenAI-compatible provider; the model must support
# tool/function calling for tests/agent/ to work. No universal default.
# Examples:
#   OpenAI:      LLM_JUDGE_BASE_URL=https://api.openai.com/v1
#   NVIDIA NIM:  LLM_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
#                LLM_JUDGE_MODEL=meta/llama-3.1-8b-instruct
#                (verified working for llm_judge; smaller hosted models on
#                NVIDIA NIM were unreliable or unresponsive when we tried
#                them -- check build.nvidia.com before picking a different
#                one, and confirm tool-calling support separately)
#   Local vLLM:  LLM_JUDGE_BASE_URL=http://localhost:8001/v1
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_MODEL=

# --- observability (Langfuse, optional) ---
# Opt-in: unset = no tracing middleware added, zero overhead. Set both keys
# to trace every tool call (any tool). LANGFUSE_BASE_URL only needed for a
# self-hosted instance -- unset uses Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
